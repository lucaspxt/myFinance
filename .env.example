# ==============================================================================
# MyFinance Environment Configuration
# ==============================================================================
# Copy this file to .env and configure with your actual values
# Never commit the .env file to version control!
# ==============================================================================

# ==============================================================================
# Database Configuration
# ==============================================================================
# PostgreSQL database name
POSTGRES_DB=myfinance

# PostgreSQL username
POSTGRES_USER=postgres

# PostgreSQL password - CHANGE THIS IN PRODUCTION!
# Use a strong, unique password for production environments
POSTGRES_PASSWORD=postgres

# Database host (localhost for local development)
DB_HOST=localhost

# Database port (5433 to avoid conflicts with system PostgreSQL on 5432)
DB_PORT=5433

# ==============================================================================
# OpenAI Configuration
# ==============================================================================
# Your OpenAI API key - REQUIRED for AI features
# Get your key at: https://platform.openai.com/api-keys
# Keep this secret and never commit it to version control!
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI chat model to use
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# gpt-4o-mini is cost-effective and fast for most use cases
OPENAI_MODEL=gpt-4o-mini

# OpenAI embedding model for vector search
# Options: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
# text-embedding-3-small is recommended for most use cases
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==============================================================================
# Application Configuration
# ==============================================================================
# CORS allowed origins (comma-separated for multiple origins)
# Development: http://localhost:4200
# Production: https://your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ==============================================================================
# Notes
# ==============================================================================
# 1. After editing this file, restart all services for changes to take effect
# 2. For production, use strong passwords and keep API keys secure
# 3. Consider using a secret management service for production deployments
# 4. Review SECURITY.md for additional security best practices
# ==============================================================================
